# Booking form (app/api/booking/route.ts). Set these in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=
# Chorro's inbox
BOOKING_TO=
# A sender on a domain verified in Resend, e.g. "chorro.com <hello@chorro.com>"
BOOKING_FROM=

# Sessions (the private console). Both are public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
